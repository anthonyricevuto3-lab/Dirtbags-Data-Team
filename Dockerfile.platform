FROM node:22-bookworm-slim AS frontend
WORKDIR /app/frontend
COPY frontend/package*.json ./
RUN npm ci
COPY frontend/ ./
RUN npm run build

FROM python:3.12-slim
WORKDIR /app
COPY requirements-platform.txt ./
RUN pip install --no-cache-dir -r requirements-platform.txt
COPY src/ ./src/
COPY migrations/ ./migrations/
COPY alembic.ini ./
COPY --from=frontend /app/frontend/dist ./frontend/dist
RUN useradd --create-home platform
USER platform
EXPOSE 5000
CMD ["sh", "-c", "alembic upgrade head && gunicorn --bind 0.0.0.0:5000 --workers 2 --timeout 120 'src.player_development.app:create_app()'"]
